<?xml version="1.0" encoding="utf-8"?>
<!--
  Pharosline — IIS settings for SmarterASP.NET (static site, no ASP.NET code).
  Upload this file next to index.html in the site root.
-->
<configuration>
  <system.webServer>
    <!-- default page -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- gzip text files (HTML/CSS/JS/JSON/SVG); images and videos are already compressed -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!-- browser caching: HTML revalidates every visit (so updates show at once); media, CSS and JS are cached -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- the branded 404 page -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <!-- File mode keeps the real 404 status (ExecuteURL answered 200, which Google treats as a "soft 404") -->
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- HTML must not be cached long, or visitors keep an old version after you upload a new one -->
  <location path="index.html">
    <system.webServer><staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" /></staticContent></system.webServer>
  </location>
  <location path="ar.html">
    <system.webServer><staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" /></staticContent></system.webServer>
  </location>
  <!-- review snapshot is rewritten on every build: keep it fresh too -->
  <location path="assets/reviews.json">
    <system.webServer><staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" /></staticContent></system.webServer>
  </location>
</configuration>
